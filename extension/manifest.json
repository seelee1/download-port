{
  "manifest_version": 3,
  "name": "下载驿站 · Download Port",
  "version": "1.0.0",
  "description": "逐层浏览已有文件夹，确认下载位置；支持仅下一次、目录搜索和下载后可靠归档。",
  "minimum_chrome_version": "120",
  "permissions": [
    "downloads",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "下载驿站",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "incognito": "not_allowed",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
